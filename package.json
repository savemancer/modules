{
  "name": "savemancer-modules",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @savemancer/devkit",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "serve:cdn": "npm run build && node scripts/serve-cdn.mjs",
    "check": "npm run validate && npm run typecheck && npm test",
    "new-module": "node scripts/new-module.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
