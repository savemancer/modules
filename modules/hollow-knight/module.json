  "status": "experimental",
  "platforms": ["pc"],
  "files": [{ "pattern": "user*.dat", "description": "user1.dat … user4.dat — слоты профилей" }],
  "saveLocations": {
    "pc": [
      "%USERPROFILE%\\AppData\\LocalLow\\Team Cherry\\Hollow Knight\\",
